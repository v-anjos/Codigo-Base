programa{
//Área de um terreno
//Calcule a área de um terreno quadrado.
//O programa deve:
//ler o valor do lado do terreno
//calcular a área
//mostrar o resultado na tela

  funcao inicio(){
    inteiro ladoDoTerreno //Declaração da Variavél que vai receber o valor do lado do terreno.
    escreva("Digite o tamanho do lado do terreno: ) //Comando Para por na tela informações ou solicitar algo do usuario.
    leia(ladoDoTereno) //Comando para receber e armazenar na variavél o valor digitado pelo usuario.
    escreva("A area do terreno é: ", ladoDoTerreno * ladoDoTerreno) // Forma que utilizei para fazer o calculo e montar o tamanho da area
  }
}
